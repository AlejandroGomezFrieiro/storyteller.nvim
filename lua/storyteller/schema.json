{
  "version": "1.3.0",
  "statuses": ["outline", "draft", "revision", "done", "unused"],
  "status_next": {
    "outline": "draft",
    "draft": "revision",
    "revision": "done",
    "done": "unused",
    "unused": "outline"
  },
  "enums": {
    "narrative_modes": ["linear", "flashback", "flash-forward", "parallel", "frame", "simultaneous", "time_skip", "dream", "mythic", "circular"],
    "persons": ["first", "second", "third"],
    "tenses": ["past", "present", "future"],
    "time_of_day": ["dawn", "morning", "afternoon", "evening", "night"]
  },
  "scene_fields": [
    "id", "status", "planning", "pov", "location", "time", "day", "at", "time_of_day",
    "goal", "conflict", "outcome", "beat", "target", "setup", "payoff",
    "tags", "chars", "locs", "items", "orgs", "ignore",
    "synopsis", "label", "narrative_mode", "duration", "intensity",
    "person", "tense", "narrator", "timeline", "also", "after", "before",
    "plotlines", "stage", "events"
  ],
  "scene_field_defs": {
    "status":   { "type": "enum", "from": "statuses", "completion": true },
    "pov":      { "type": "reference", "ref_type": "character", "completion": true },
    "location": { "type": "reference", "ref_type": "location", "completion": true },
    "chars":    { "type": "reference-list", "ref_type": "character", "completion": true },
    "locs":     { "type": "reference-list", "ref_type": "location", "completion": true },
    "items":    { "type": "reference-list", "ref_type": "item", "completion": true },
    "orgs":     { "type": "reference-list", "ref_type": "organization", "completion": true },
    "setup":    { "type": "thread-key", "completion": true },
    "payoff":   { "type": "thread-key", "completion": true },
    "time":     { "type": "string" },
    "day":      { "type": "string" },
    "at":       { "type": "string" },
    "time_of_day": { "type": "enum", "from": "time_of_day", "completion": true },
    "synopsis": { "type": "string" },
    "label":    { "type": "string" },
    "narrative_mode": { "type": "enum", "from": "narrative_modes", "completion": true },
    "duration": { "type": "string" },
    "intensity": { "type": "number" },
    "person":   { "type": "enum", "from": "persons", "completion": true },
    "tense":    { "type": "enum", "from": "tenses", "completion": true },
    "narrator": { "type": "reference", "ref_type": "character", "completion": true },
    "timeline": { "type": "reference", "ref_type": "timeline", "completion": true },
    "also":     { "type": "string" },
    "after":    { "type": "string" },
    "before":   { "type": "string" },
    "plotlines": { "type": "reference-list", "ref_type": "plotline", "completion": true },
    "stage":    { "type": "string" },
    "events":   { "type": "reference-list", "ref_type": "event", "completion": true }
  },
  "chapter_fields": [
    "type", "pov", "location", "status", "planning", "target",
    "chars", "locs", "items", "orgs", "ignore", "tags", "aliases", "names"
  ],
  "chapter_field_defs": {
    "status":   { "type": "enum", "from": "statuses", "completion": true },
    "pov":      { "type": "reference", "ref_type": "character", "completion": true },
    "location": { "type": "reference", "ref_type": "location", "completion": true },
    "chars":    { "type": "reference-list", "ref_type": "character", "completion": true },
    "locs":     { "type": "reference-list", "ref_type": "location", "completion": true },
    "items":    { "type": "reference-list", "ref_type": "item", "completion": true },
    "orgs":     { "type": "reference-list", "ref_type": "organization", "completion": true }
  },
  "list_fields": ["tags", "chars", "locs", "items", "orgs", "ignore", "aliases", "names", "also", "plotlines", "events"],
  "scene_sentinel": "storyteller: scene",
  "reference_types": {
    "character":     { "dir": "characters",     "label": "Character",     "field": "chars",
                       "body": ["Role", "Notes"], "min_fields": ["Role"] },
    "location":      { "dir": "locations",      "label": "Location",      "field": "locs",
                       "body": ["Atmosphere", "Notes"], "min_fields": [] },
    "item":          { "dir": "items",          "label": "Item",          "field": "items",
                       "body": ["Type", "Notes"], "min_fields": [] },
    "organization":  { "dir": "organizations",  "label": "Organization",  "field": "orgs",
                       "body": ["Wants", "Members", "Notes"], "min_fields": [] },
    "timeline":      { "dir": "timelines",      "label": "Timeline",      "field": "timeline",
                       "body": ["Notes"], "min_fields": [] },
    "plotline":      { "dir": "plotlines",      "label": "Plotline",      "field": "plotlines",
                       "body": ["Notes"], "min_fields": [] },
    "event":         { "dir": "events",         "label": "Event",         "field": "events",
                       "body": ["When", "Notes"], "min_fields": [] }
  },
  "document_types": {
    "part":     { "label": "Part",     "heading_level": 1, "contains": ["chapter"] },
    "chapter":  { "label": "Chapter",  "heading_level": 1, "contains": ["scene", "beat"] },
    "scene":    { "label": "Scene",    "heading_level": 2, "metadata": true },
    "beat":     { "label": "Beat",     "heading_level": 3 }
  },
  "diagnostics": {
    "unknown_field": true,
    "invalid_enum": true,
    "missing_id": false,
    "unresolved_setup": true,
    "unresolved_payoff": true,
    "timeline_regression": true,
    "timeline_overlap": true,
    "timeline_gap": false,
    "relative_unresolved": true,
    "sync_conflict": true,
    "stage_regression": true,
    "orphan_plotline": true,
    "uncovered_stage": true,
    "event_conflict": true,
    "bilocation": false,
    "dangling_relation": true,
    "narration_consistency": false,
    "duplicate_alias": true,
    "missing_min_fields": true,
    "duplicate_id": true,
    "incomplete_beat": true,
    "over_target": true,
    "chars_not_mentioned": true
  }
}
