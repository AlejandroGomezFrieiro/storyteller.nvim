Output docs/assets/19-tui.gif

Set Shell "bash"
Set Theme "Catppuccin Frappe"
Set FontSize 18
Set Width 1000
Set Height 560
Set Padding 20
Set Margin 18
Set MarginFill "#1e1e2e"
Set BorderRadius 12
Set WindowBar Colorful
Set CursorBlink false
Set Framerate 60
Set PlaybackSpeed 1.0
Set TypingSpeed 45ms

Show
Type "storyteller-tui docs/vhs/demo"
Enter
Sleep 3s
# Same grammar as the editor: Tab cycles views, j/k moves.
Type "Tab"
Sleep 2000ms
Type "j"
Sleep 400ms
Type "j"
Sleep 800ms
Type "Tab"
Sleep 2000ms
Type "k"
Sleep 800ms
Hide
Type "q"
Sleep 500ms
Show
Sleep 500ms
